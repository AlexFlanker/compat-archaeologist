          "token": "$lookup",
          "detail": "Code uses $lookup",
          "origin": "static_scan_only"
        }
      ],
      "independent_sources": 2,
      "status": "OBSERVED",
      "confidence": 0.9,
      "confidence_basis": "2 independent sources agree",
      "sample_operations": [
        {
          "op": "command",
          "ns": "shoplog_wl.orders",
          "command": {
            "aggregate": "orders",
            "pipeline": [
              {
                "$match": {
                  "placed_at": {
                    "$gte": "2017-07-01 00:00:00",
                    "$lt": "2017-08-01 00:00:00"
                  },
                  "status": {
                    "$ne": "cancelled"
                  }
                }
              },
              {
                "$addFields": {
                  "total_cents": {
                    "$cond": [
                      {
                        "$eq": [
                          {
                            "$type": "$total"
                          },
                          "double"
                        ]
                      },
                      {
                        "$round": [
                          {
                            "$multiply": [
                              "$total",
                              100
                            ]
                          },
                          0
                        ]
                      },
                      "$total"
                    ]
                  }
                }
              },
              {
                "$lookup": {
                  "from": "customers",
                  "let": {
                    "cid": "$customer_id"
                  },
                  "pipeline": [
                    {
                      "$match": {
                        "$expr": {
                          "$eq": [
                            "$_id",
                            "$$cid"
                          ]
                        }
                      }
                    },
                    {
                      "$project": {
                        "tier": 1,
                        "_id": 0
                      }
                    }
                  ],
                  "as": "customer"
                }
              },
              {
                "$unwind": "$customer"
              },
              {
                "$facet": {
                  "by_tier": [
                    {
                      "$group": {
                        "_id": "$customer.tier",
                        "revenue": {
                          "$sum": "$total_cents"
                        },
                        "orders": {
                          "$sum": 1
                        }
                      }
                    },
                    {
                      "$sort": {
                        "_id": 1
                      }
                    }
                  ],
                  "by_month": [
                    {
                      "$group": {
                        "_id": {
                          "$dateToString": {
                            "format": "%Y-%m",
                            "date": "$placed_at"
                          }
                        },
                        "revenue": {
                          "$sum": "$total_cents"
                        }
                      }
                    },
                    {
                      "$sort": {
                        "_id": 1
                      }
                    }
                  ],
                  "largest": [
                    {
                      "$sort": {
                        "total_cents": -1,
                        "_id": 1
                      }
                    },
                    {
                      "$limit": 5
                    },
                    {
                      "$project": {
                        "total_cents": 1,
                        "tier": "$customer.tier"
                      }
                    }
                  ]
                }
              }
            ],
            "cursor": {}
          }
        },
        {
          "op": "command",
          "ns": "shoplog_wl.products",
          "command": {
            "aggregate": "products",
            "pipeline": [
              {
                "$lookup": {
                  "from": "inventory",
                  "localField": "_id",
                  "foreignField": "_id",
                  "pipeline": [
                    {
                      "$match": {
                        "$expr": {
                          "$lt": [
                            "$on_hand",
                            50
                          ]
                        }
                      }
                    }
                  ],
                  "as": "stock"
                }
              },
              {
                "$match": {
                  "stock.0": {
                    "$exists": true
                  }
                }
              },
              {
                "$group": {
                  "_id": "$category",
                  "skus": {
                    "$sum": 1
                  }
                }
              },
              {
                "$sort": {
                  "skus": -1,
                  "_id": 1
                }
              }
            ],
            "cursor": {}
          }
        }
      ]
    },
