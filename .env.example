# Copy to .env (git-ignored) and fill in the three blank values.

# Meta Model API (https://dev.meta.ai/docs/quickstart). MODEL_API_KEY, Meta's own name, also works.
META_API_KEY=
META_MODEL=muse-spark-1.3

# SubQ Snap decision model (https://docs.subq.ai/endpoints/decisions-api/)
SUBQ_API_KEY=
SUBQ_MODEL=subq-snap-1.1

# MongoDB Atlas: stores ledger, runs and memos. Never used for the benchmark.
MONGODB_URI_ATLAS=

# Local engines. Both ports are bound to 127.0.0.1 by docker-compose.yml.
# These are throwaway local-only credentials for the FerretDB container.
FERRETDB_USER=ca_local
FERRETDB_PASSWORD=local-only-not-a-secret
SOURCE_URI=mongodb://127.0.0.1:27017/?directConnection=true
TARGET_URI=mongodb://ca_local:local-only-not-a-secret@127.0.0.1:27018/
